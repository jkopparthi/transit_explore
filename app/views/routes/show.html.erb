<p><%= link_to "← All routes", routes_path %></p>
<h1 class="h3"><%= @route.name %></h1>
  <p class="text-muted"><%= pluralize(@stops.total_count, "stop") %> on this route</p>

<% if @stops.empty? %>
  <div class="alert alert-info">No stops have been loaded for this route yet.</div>
<% else %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th scope="col">Stop #</th>
        <th scope="col">Name</th>
        <th scope="col">Street</th>
      </tr>
    </thead>
    <tbody>
      <% @stops.each do |stop| %>
        <tr>
          <td><%= stop.stop_number %></td>
          <td><%= link_to stop.name, stop %></td>
          <td><%= link_to stop.street.name, stop.street %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= paginate @stops %>
<% end %>