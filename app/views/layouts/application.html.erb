<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Transit Explorer" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-md navbar-dark bg-dark">
      <div class="container">
        <%= link_to "Transit Explorer", root_path, class: "navbar-brand" %>
        <ul class="navbar-nav">
          <li class="nav-item"><%= link_to "Stops", stops_path, class: "nav-link" %></li>
                    <li class="nav-item"><%= link_to "Routes", routes_path, class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "Streets", streets_path, class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "About", about_path, class: "nav-link" %></li>
        </ul>
      </div>
    </nav>

    <main class="container my-4">
      <%= yield %>
    </main>
  </body>
</html>